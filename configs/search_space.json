{
  "version": "1.0",
  "track": "AI智能赛道",
  "objective": "0.3 * A_proxy_percentile + 0.7 * model_score_percentile",
  "families": {
    "PERSISTENT_BOOK_PRESSURE_UNDERREACTION": {
      "tail_minutes": [15, 30, 60, 120],
      "depth": [1, 5, 10],
      "replenishment_weight": [0.2, 0.35],
      "microprice_weight": [0.2],
      "candidate_count": 24
    },
    "PIT_QUALITY_FLOW_CONFIRMATION": {
      "tail_minutes": [15, 30, 60, 120],
      "depth": [1, 5, 10],
      "freshness_days": [90, 180],
      "quality_change_weight": [0.2],
      "candidate_count": 24
    }
  },
  "chronological_split": {
    "generation": ["2019-01-01", "2022-12-31"],
    "selection": ["2023-01-01", "2023-12-31"],
    "frozen_holdout": ["2024-01-01", "2024-12-31"]
  },
  "admission_rules": {
    "same_rank_ic_direction_all_periods": true,
    "holdout_to_development_ic_ratio_min": 0.5,
    "elastic_net_nonzero_window_ratio_min": 0.6,
    "max_rank_correlation_with_factorlib": 0.7,
    "target_pairwise_rank_correlation": 0.5
  }
}

